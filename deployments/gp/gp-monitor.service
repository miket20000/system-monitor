[Unit]
Description=GP server health monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/gp-monitor/telegram.env
ExecStart=/usr/local/lib/gp-monitor/gp-monitor.py
User=root
Group=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/lib/gp-monitor
